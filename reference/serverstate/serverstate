#!/usr/bin/env bash
# serverstate — capture, document and rebuild this server.
#
#   serverstate snapshot [--push|--auto-push] [--quiet]
#                                capture everything -> $STATE_DIR (git-versioned),
#                                regenerate CONTEXT.md, optionally upload bundle to R2
#   serverstate push [--force]   encrypt + upload the state bundle (rclone)
#   serverstate pull [REMOTE]    download + decrypt latest bundle (new machine)
#   serverstate restore --bundle DIR|FILE [--only a,b] [--from p] [--skip a,b] [--dry-run] [--yes]
#   serverstate restore --list   show restore phases
#   serverstate context          regenerate CONTEXT.md only
#   serverstate notes            edit your hand-written NOTES.md (merged into CONTEXT.md)
#   serverstate log | diff [REV] change history of the server
#   serverstate status           health of snapshots / pushes / watcher
#   serverstate watch            daemon: auto-snapshot shortly after changes
#   serverstate hook-backup FILE insert "snapshot + push" at the top of your backup script
#   serverstate final-backup     cutover: snapshot, stop containers, run backup, push
#   serverstate audit            find things NOT captured / NOT backed up (writes audit.md)
#   serverstate uninstall [--purge]   remove serverstate (keeps state for moi unless --purge)
set -Eeuo pipefail

SS_VERSION="1.0.0"
SELF=$(readlink -f "${BASH_SOURCE[0]}")
LIB_DIR=$(dirname "$SELF")
HELPER="$LIB_DIR/sshelper.py"
CONF=${SERVERSTATE_CONF:-/etc/serverstate.conf}

# ----------------------------------------------------------------------------
# Defaults — override in /etc/serverstate.conf
# ----------------------------------------------------------------------------
STATE_DIR=/var/lib/serverstate
DATA_ROOTS=auto
TREE_DEPTH=4
TREE_SIZES=no
COMPOSE_SEARCH_PATHS="/opt /srv /home /root /docker /data /mnt"
SCRIPT_DIRS="/usr/local/bin /usr/local/sbin /root/bin /root/scripts /home/*/bin /home/*/scripts /opt/scripts"
HOME_FILES=".bashrc .bash_aliases .bash_profile .profile .zshrc .zprofile .gitconfig .tmux.conf .vimrc .ssh .config/rclone .config/restic .aws .docker/config.json .config/systemd/user .local/bin"
EXTRA_CAPTURE=""
PRUNE_DIRS=".git node_modules __pycache__ .cache cache logs log tmp temp data db database postgres postgresql pgdata mysql mariadb redis media library transcodes thumbnails thumbs backups backup downloads"
MAX_FILE_KB=1024
MAX_FILES_PER_TREE=3000
RCLONE_REMOTE=""
RCLONE_FLAGS=""
PASSPHRASE_FILE=/root/.serverstate-passphrase
KEEP_REMOTE_DAYS=60
AUTO_PUSH=yes
AUTO_PUSH_MIN_INTERVAL=3600
BACKUP_PATHS=""
BACKUP_CMD=""
BACKUP_RESTORE_CMD=""
NOT_BACKED_UP_OK=""
CONTEXT_COPIES=""
WATCH_DEBOUNCE=120
# big/regenerable dirs inside /etc that are not config (Dokploy app code clones, logs…)
ETC_EXCLUDE="/etc/dokploy/applications /etc/dokploy/logs /etc/dokploy/compose /etc/dokploy/volume-backups /etc/ssl/certs"
RESTORE_ETC_PATHS="/etc/ssh/sshd_config /etc/ssh/ssh_host_ed25519_key /etc/ssh/ssh_host_ed25519_key.pub /etc/ssh/ssh_host_rsa_key /etc/ssh/ssh_host_rsa_key.pub /etc/ssh/ssh_host_ecdsa_key /etc/ssh/ssh_host_ecdsa_key.pub /etc/ssh/sshd_config.d /etc/sysctl.conf /etc/sysctl.d /etc/modules-load.d /etc/modprobe.d /etc/security/limits.d /etc/sudoers.d /etc/environment /etc/logrotate.d /etc/fail2ban /etc/ufw /etc/default/ufw /etc/nftables.conf /etc/iptables /etc/wireguard /etc/cloudflared /etc/samba /etc/exports /etc/snapraid.conf /etc/msmtprc /etc/aliases /etc/nginx /etc/caddy /etc/crowdsec /etc/rclone /etc/restic /etc/serverstate.conf /etc/apt/apt.conf.d/50unattended-upgrades /etc/apt/apt.conf.d/20auto-upgrades /etc/docker /etc/dokploy"
# shellcheck source=/dev/null
[[ -r $CONF ]] && . "$CONF"
export SS_NOT_BACKED_UP_OK="$NOT_BACKED_UP_OK"

# ----------------------------------------------------------------------------
# helpers
# ----------------------------------------------------------------------------
QUIET=0
if [[ -t 2 ]]; then C_B=$'\033[1;34m' C_Y=$'\033[1;33m' C_R=$'\033[1;31m' C_G=$'\033[1;32m' C_0=$'\033[0m'; else C_B='' C_Y='' C_R='' C_G='' C_0=''; fi
log()  { ((QUIET)) || printf '%s==>%s %s\n' "$C_B" "$C_0" "$*" >&2; }
info() { ((QUIET)) || printf '    %s\n' "$*" >&2; }
ok()   { ((QUIET)) || printf '    %s✓%s %s\n' "$C_G" "$C_0" "$*" >&2; }
warn() { printf '%sWARN:%s %s\n' "$C_Y" "$C_0" "$*" >&2; }
die()  { printf '%sERROR:%s %s\n' "$C_R" "$C_0" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
need_root() { [[ $EUID -eq 0 ]] || die "run as root (sudo serverstate $*)"; }
py() { python3 "$HELPER" "$@"; }

# cap OUTFILE CMD...  — capture stdout of CMD; failures and empty output are ignored
cap() {
  local out=$1; shift
  mkdir -p "$(dirname "$out")"
  timeout "${CAP_TIMEOUT:-120}" "$@" >"$out" 2>/dev/null || true
  [[ -s $out ]] || rm -f "$out"
}

# section NAME FUNC — run a capture section; one failing section never aborts the snapshot
section() {
  local name=$1; shift
  info "· $name"
  ( set +e; "$@"; exit 0 ) || warn "section '$name' reported errors (continuing)"
}

build_exprs() {
  PRUNE_EXPR=(); local n
  for n in $PRUNE_DIRS; do PRUNE_EXPR+=(-name "$n" -o); done
  if ((${#PRUNE_EXPR[@]})); then unset 'PRUNE_EXPR[${#PRUNE_EXPR[@]}-1]'; else PRUNE_EXPR=(-false); fi
  # light prune: for finding compose files and copying script dirs (stack dirs may be called "media", "backup"…)
  LIGHT_EXPR=(-name .git -o -name node_modules -o -name __pycache__ -o -name .cache -o -name venv -o -name .venv -o -name site-packages)
  SKIP_FILE_EXPR=(! -name '*.sqlite' ! -name '*.sqlite3' ! -name '*.db' ! -name '*.db-*' ! -name '*.log'
                  ! -name '*.pid' ! -name '*-wal' ! -name '*-shm' ! -name '*.mkv' ! -name '*.mp4' ! -name '*.iso')
}

# grab [-p|-l] PATH...  — copy files/dirs into $FILES mirroring absolute paths (perms+owners kept by tar)
#   -p : app-tree mode — prune data-ish dirs (PRUNE_DIRS), depth GRAB_DEPTH, cap MAX_FILES_PER_TREE
#   -l : like -p but only prunes .git/node_modules/venvs (script dirs)
grab() {
  local prune=0; local -a pe=("${PRUNE_EXPR[@]}")
  case ${1:-} in -p) prune=1; shift ;; -l) prune=1; pe=("${LIGHT_EXPR[@]}"); shift ;; esac
  local list p; list=$(mktemp)
  for p in "$@"; do
    [[ -e $p || -L $p ]] || continue
    if [[ -d $p && ! -L $p ]]; then
      if ((prune)); then
        { find "$p" -mindepth 1 -maxdepth "${GRAB_DEPTH:-6}" \( -type d \( "${pe[@]}" \) -prune \) -o \
            \( \( -type f -o -type l \) -size -"${MAX_FILE_KB}"k "${SKIP_FILE_EXPR[@]}" -print0 \) 2>/dev/null \
            | head -z -n "$MAX_FILES_PER_TREE"; } || true
      else
        local -a skp=(-name .git); local x
        for x in ${GRAB_SKIP:-}; do skp+=(-o -path "$x"); done
        find "$p" \( -type d \( "${skp[@]}" \) -prune \) -o \( \( -type f -o -type l \) -size -"${MAX_FILE_KB}"k -print0 \) 2>/dev/null || true
      fi
    else
      printf '%s\0' "$p"
    fi
  done >"$list"
  if [[ -s $list ]]; then
    { tar --null --no-recursion -T "$list" -cf - 2>/dev/null | tar -xf - -C "$FILES" 2>/dev/null; } || true
    xargs -0 -r stat --printf '%a\t%U\t%G\t%n\n' <"$list" >>"$MANIFEST" 2>/dev/null || true
  fi
  rm -f "$list"
}

# Strip volatile/auto-generated parts from iptables-save output (docker chains, counters, fail2ban bans)
ipt_filter() {
  sed -E 's/ \[[0-9]+:[0-9]+\]$//' | awk '
    /^#/ {next}
    /DOCKER/ && !/DOCKER-USER/ {next}
    /docker0|br-[0-9a-f]+/ {next}
    /^-A f2b-[^ ]+ -s / {next}
    {print}'
}

data_roots() {
  if [[ $DATA_ROOTS != auto ]]; then printf '%s\n' $DATA_ROOTS; return; fi
  {
    findmnt -rn -o TARGET,FSTYPE 2>/dev/null | awk '$2 ~ /^(ext[234]|xfs|btrfs|zfs|f2fs|ntfs|ntfs3|exfat|vfat|fuse\.mergerfs|fuse\.shfs|nfs4?|cifs)$/ {print $1}' \
      | grep -vE '^(/|/boot.*|/var|/var/lib/docker.*|/snap.*|/run.*|/tmp|/usr.*|/var/log)$'
    local d; for d in /srv /opt /data /home /mnt /media; do [[ -d $d ]] && echo "$d"; done
  } | sort -u
}

# ----------------------------------------------------------------------------
# SNAPSHOT sections
# ----------------------------------------------------------------------------
snap_meta() {
  local d=$S/meta; mkdir -p "$d"
  { hostname -f 2>/dev/null || hostname; } >"$d/hostname"
  cap "$d/os-release" cat /etc/os-release
  cap "$d/kernel" uname -srmo
  cap "$d/cmdline" cat /proc/cmdline
  cap "$d/lscpu" bash -c "lscpu | grep -viE 'mhz|bogomips|vulnerab'"
  cap "$d/memory" bash -c "awk '/MemTotal|SwapTotal/' /proc/meminfo"
  cap "$d/dmi" bash -c 'for f in sys_vendor product_name product_version board_vendor board_name; do printf "%s: %s\n" "$f" "$(cat /sys/class/dmi/id/$f 2>/dev/null)"; done'
  cap "$d/timezone" bash -c 'timedatectl show -p Timezone --value 2>/dev/null || cat /etc/timezone'
  cap "$d/virt" systemd-detect-virt
  cap "$d/locale" bash -c 'localectl status 2>/dev/null | sed -n "s/.*LANG=//p"'
  echo "$SS_VERSION" >"$d/serverstate-version"
  cap "$V/uptime" uptime
  cap "$V/free" free -h
}

snap_packages() {
  local d=$S/packages; mkdir -p "$d"
  if have dpkg-query; then
    echo debian >"$d/family"
    cap "$d/apt-manual.txt" bash -c 'apt-mark showmanual | sort'
    cap "$d/apt-hold.txt" apt-mark showhold
    cap "$V/apt-all.tsv" dpkg-query -W -f='${Package}\t${Version}\n'
    grab /usr/share/keyrings
  elif have rpm; then
    echo rhel >"$d/family"
    have dnf && cap "$d/dnf-userinstalled.txt" bash -c 'dnf repoquery --userinstalled --qf "%{name}" 2>/dev/null | sort -u'
    cap "$V/rpm-all.txt" bash -c 'rpm -qa | sort'
  fi
  have snap    && cap "$d/snap.txt" bash -c "snap list 2>/dev/null | awk 'NR>1{print \$1\"\t\"\$4\"\t\"\$6}'"
  have flatpak && cap "$d/flatpak.txt" flatpak list --app --columns=application
  # read pipx venv dirs directly (running `pipx list` writes log files)
  cap "$d/pipx.txt" bash -c 'ls -1 /root/.local/share/pipx/venvs /home/*/.local/share/pipx/venvs /opt/pipx/venvs 2>/dev/null | grep -v ":$" | grep . | sort -u'
  have pip3    && cap "$d/pip3-freeze.txt" pip3 freeze
  have npm     && cap "$d/npm-global.txt" bash -c 'npm ls -g --depth=0 --json 2>/dev/null | python3 -c "import json,sys; print(\"\n\".join(sorted(json.load(sys.stdin).get(\"dependencies\",{}))))"'
  have cargo   && cap "$d/cargo.txt" cargo install --list
  cap "$d/usr-local-bin.txt" bash -c 'for f in /usr/local/bin/* /usr/local/sbin/*; do [ -e "$f" ] || continue; printf "%s\t%s\n" "$f" "$(file -b "$f" 2>/dev/null | cut -c1-70)"; done'
  cap "$d/opt-listing.txt" ls -1 /opt
}

snap_docker() {
  have docker || return 0
  local d=$S/docker ids vols nets daemon=1 p kind path; mkdir -p "$d"
  docker info >/dev/null 2>&1 || { daemon=0; warn "docker daemon not reachable — capturing compose files on disk only"; }
  if ((daemon)); then
    cap "$d/version.txt" docker version --format '{{.Server.Version}}'
    cap "$d/compose-version.txt" docker compose version --short
    cap "$d/root-dir.txt" docker info --format '{{.DockerRootDir}}'
    cap "$V/docker-info.txt" docker info
    ids=$(docker ps -aq)
    [[ -n $ids ]] && docker inspect $ids 2>/dev/null | py normalize-containers >"$d/containers.json"
    nets=$(docker network ls -q)
    [[ -n $nets ]] && docker network inspect $nets 2>/dev/null | py normalize-networks >"$d/networks.json"
    vols=$(docker volume ls -q)
    [[ -n $vols ]] && docker volume inspect $vols 2>/dev/null | py normalize-volumes >"$d/volumes.json"
    cap "$V/docker-ps.tsv" docker ps -a --format '{{.Names}}\t{{.State}}\t{{.Status}}\t{{.Image}}'
    cap "$V/docker-images.tsv" docker image ls --format '{{.Repository}}:{{.Tag}}\t{{.ID}}\t{{.CreatedSince}}\t{{.Size}}'
    cap "$V/docker-volume-sizes.tsv" bash -c 'for v in $(docker volume ls -q); do [ ${#v} -eq 64 ] && continue; m=$(docker volume inspect -f "{{.Mountpoint}}" "$v"); printf "%s\t%s\n" "$v" "$(timeout 20 du -sh "$m" 2>/dev/null | cut -f1)"; done'
    cap "$V/docker-dangling-volumes.txt" bash -c 'docker volume ls -qf dangling=true | wc -l'
    cap "$V/compose-ls.json" docker compose ls -a --format json
    if [[ $(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null) == active ]]; then
      echo active >"$d/swarm-state"
      local svcs; svcs=$(docker service ls -q 2>/dev/null)
      [[ -n $svcs ]] && docker service inspect $svcs 2>/dev/null | py normalize-services "$d/networks.json" >"$d/services.json"
      cap "$d/stacks.txt" docker stack ls --format '{{.Name}}\t{{.Services}}'
      cap "$d/swarm-nodes.txt" docker node ls --format '{{.Hostname}}\t{{.ManagerStatus}}\t{{.Availability}}'
      cap "$d/swarm-secrets.txt" docker secret ls --format '{{.Name}}'
      cap "$d/swarm-configs.txt" docker config ls --format '{{.Name}}'
      cap "$V/service-ls.tsv" docker service ls --format '{{.Name}}\t{{.Replicas}}\t{{.Image}}\t{{.Ports}}'
    fi
  fi
  # compose projects: from running containers (labels), `docker compose ls`, and compose files lying on disk
  for p in $COMPOSE_SEARCH_PATHS; do
    [[ -d $p ]] || continue
    find "$p" -mindepth 1 -maxdepth 4 \( -type d \( "${LIGHT_EXPR[@]}" -o -name overlay2 -o -name volumes -o -name pgdata -o -name postgres -o -name mysql \) -prune \) -o -type f \
      \( -name docker-compose.yml -o -name docker-compose.yaml -o -name compose.yml -o -name compose.yaml \) -print 2>/dev/null
  done | sort -u >"$V/compose-found.txt"
  py compose-projects "$d/containers.json" "$V/compose-ls.json" "$V/compose-found.txt" >"$d/compose-projects.json"
  while IFS=$'\t' read -r kind path; do
    case $kind in dir) GRAB_DEPTH=4 grab -p "$path" ;; file) grab "$path" ;; esac
  done < <(py compose-paths "$d/compose-projects.json")
  py standalone-run "$d/containers.json" "$d/standalone"
  rmdir "$d/standalone" 2>/dev/null || true
}

snap_cron() {
  local d=$S/cron u; mkdir -p "$d"
  grab /var/spool/cron
  for u in $(cut -d: -f1 /etc/passwd); do
    crontab -l -u "$u" >"$d/user-$u.crontab" 2>/dev/null || rm -f "$d/user-$u.crontab"
    [[ -s $d/user-$u.crontab ]] || rm -f "$d/user-$u.crontab"
  done
  cap "$d/enabled-timers.txt" bash -c "systemctl list-unit-files --type=timer --state=enabled --no-legend --no-pager | awk '{print \$1}'"
  cap "$V/systemd-timers-schedule.txt" systemctl list-timers --all --no-pager
}

snap_systemd() {
  local d=$S/systemd; mkdir -p "$d"
  cap "$d/enabled-units.txt" bash -c "systemctl list-unit-files --state=enabled --no-legend --no-pager | awk '{print \$1}' | sort"
  cap "$d/custom-units.txt" bash -c "find /etc/systemd/system -maxdepth 2 -type f \( -name '*.service' -o -name '*.timer' -o -name '*.mount' -o -name '*.automount' -o -name '*.path' -o -name '*.socket' -o -name '*.target' -o -name '*.conf' \) ! -name 'snap-*' ! -name 'snap.*' | sort"
  cap "$d/unit-file-states.txt" bash -c "systemctl list-unit-files --type=service --no-legend --no-pager | awk '{print \$1, \$2}' | sort"
  cap "$V/running-services.txt" systemctl list-units --type=service --state=running --no-legend --no-pager --plain
  cap "$V/failed-units.txt" systemctl list-units --failed --no-legend --no-pager --plain
  cap "$d/triggered-by.txt" bash -c 'systemctl list-units --type=service --state=running --no-legend --no-pager --plain | awk "{print \$1}" | while read -r u; do t=$(systemctl show -p TriggeredBy --value "$u" 2>/dev/null); [ -n "$t" ] && echo "$u $t"; done'
}

snap_etc() {
  GRAB_SKIP="$ETC_EXCLUDE" grab /etc
  rm -rf "$FILES/etc/ld.so.cache" "$FILES/etc/adjtime" "$FILES/etc/.pwd.lock" 2>/dev/null || true
}

snap_firewall() {
  local d=$S/firewall; mkdir -p "$d"
  if have iptables-save; then
    cap "$V/iptables.raw" iptables-save
    cap "$d/iptables.rules" bash -c "iptables-save 2>/dev/null | $(declare -f ipt_filter); ipt_filter"
  fi
  if have ip6tables-save; then
    cap "$V/ip6tables.raw" ip6tables-save
    cap "$d/ip6tables.rules" bash -c "ip6tables-save 2>/dev/null | $(declare -f ipt_filter); ipt_filter"
  fi
  have nft && cap "$V/nftables.ruleset" nft list ruleset
  have ipset && cap "$d/ipset-names.txt" ipset list -n
  if have ufw; then cap "$d/ufw-status.txt" ufw status verbose; cap "$d/ufw-added.txt" ufw show added; fi
  {
    have ufw && ufw status 2>/dev/null | grep -q 'Status: active' && echo ufw
    systemctl is-active --quiet firewalld 2>/dev/null && echo firewalld
    systemctl is-enabled --quiet nftables 2>/dev/null && echo nftables
    { systemctl is-enabled --quiet netfilter-persistent 2>/dev/null || [[ -f /etc/iptables/rules.v4 ]]; } && echo iptables-persistent
    systemctl is-active --quiet fail2ban 2>/dev/null && echo fail2ban
    systemctl is-active --quiet crowdsec 2>/dev/null && echo crowdsec
    systemctl is-active --quiet crowdsec-firewall-bouncer 2>/dev/null && echo crowdsec-firewall-bouncer
  } >"$d/managers.txt" || true
  [[ -s $d/managers.txt ]] || rm -f "$d/managers.txt"
  if have fail2ban-client; then
    cap "$V/fail2ban-status.txt" fail2ban-client status
    cap "$d/fail2ban-jails.txt" bash -c "fail2ban-client status 2>/dev/null | sed -n 's/.*Jail list:[[:space:]]*//p' | tr -d ' ' | tr ',' '\n'"
  fi
  if have cscli; then
    cap "$d/crowdsec-collections.txt" bash -c "cscli collections list -o raw 2>/dev/null | cut -d, -f1,2"
    cap "$V/crowdsec-bouncers.txt" cscli bouncers list
  fi
}

snap_network() {
  local d=$S/network; mkdir -p "$d"
  cap "$d/addresses.txt" bash -c "ip -br addr | grep -vE '^(veth|docker0|br-)'"
  cap "$d/links.txt" bash -c "ip -br link | grep -vE '^(veth|docker0|br-)'"
  cap "$d/routes.txt" bash -c "ip route | grep -vE 'docker0|br-'"
  cap "$d/dns.txt" bash -c "{ resolvectl dns 2>/dev/null || grep ^nameserver /etc/resolv.conf; } | grep -vE '\((veth|br-|docker)' | grep -vE ':\s*$'"
  cap "$V/listening.txt" bash -c "ss -tulpnH | sed -E 's/,pid=[0-9]+//g; s/,fd=[0-9]+//g' | awk '{print \$1, \$5, \$7}' | sort -u"
  if have tailscale; then cap "$d/tailscale-ip.txt" tailscale ip -4; cap "$V/tailscale-status.txt" tailscale status; fi
  have wg && cap "$d/wireguard-interfaces.txt" wg show interfaces
}

snap_storage() {
  local d=$S/storage r name; mkdir -p "$d" "$V/trees"
  cap "$d/lsblk.json" lsblk -J -b -o NAME,PATH,SIZE,TYPE,FSTYPE,LABEL,UUID,PARTUUID,MOUNTPOINT,MODEL,SERIAL,ROTA,TRAN -e 7
  [[ -s $d/lsblk.json ]] || cap "$d/lsblk.json" lsblk -J -b -o NAME,SIZE,TYPE,FSTYPE,LABEL,UUID,MOUNTPOINT,MODEL,SERIAL,ROTA -e 7
  cap "$d/mounts.txt" bash -c "findmnt -rn -o TARGET,SOURCE,FSTYPE,OPTIONS | awk '\$3 !~ /^(overlay|tmpfs|proc|sysfs|cgroup2?|devpts|mqueue|debugfs|tracefs|securityfs|pstore|bpf|configfs|fusectl|hugetlbfs|autofs|nsfs|devtmpfs|squashfs|efivarfs|binfmt_misc|ramfs|rpc_pipefs|fuse\\.lxcfs|fuse\\.gvfsd-fuse|fuse\\.portal)\$/' | grep -vE '^/(var/lib/docker|run|snap)/' | sort"
  cap "$d/blkid.txt" blkid
  cap "$V/df.txt" df -hT -x tmpfs -x devtmpfs -x overlay -x squashfs -x efivarfs
  if have mdadm; then cap "$d/mdadm-scan.txt" mdadm --detail --scan; cap "$V/mdstat.txt" cat /proc/mdstat; fi
  have pvs && cap "$d/lvm.txt" bash -c 'pvs 2>/dev/null; echo; vgs 2>/dev/null; echo; lvs 2>/dev/null'
  if have zpool; then
    cap "$d/zpool-list.txt" zpool list -H -o name,size,health
    cap "$d/zfs-datasets.txt" zfs list -H -o name,mountpoint
    cap "$V/zpool-status.txt" zpool status
    cap "$V/zfs-usage.txt" zfs list
  fi
  have btrfs && cap "$d/btrfs-subvolumes.txt" bash -c 'findmnt -rn -t btrfs -o TARGET | while read -r m; do echo "== $m"; btrfs subvolume list "$m"; done'
  have smartctl && cap "$V/smart.txt" bash -c 'for dev in $(smartctl --scan | awk "{print \$1}"); do echo "== $dev"; smartctl -i -H "$dev" | grep -E "Model|Serial|Capacity|Rotation|Form Factor|overall-health|SMART Health"; done'
  data_roots >"$d/data-roots.txt"
  while read -r r; do
    [[ -d $r ]] || continue
    name=$(sed 's#^/##; s#/#_#g' <<<"$r"); [[ -z $name ]] && name=root
    timeout 600 find "$r" -xdev -maxdepth "$TREE_DEPTH" \( -name lost+found -o -name '.Trash-*' -o -name '@eaDir' -o -name '.snapshots' -o -name node_modules -o -name .git \) -prune \
      -o -type d -printf '%m\t%u\t%g\t%p\n' 2>/dev/null | sort -t$'\t' -k4 >"$V/trees/$name.tsv" || true
    [[ $TREE_SIZES == yes ]] && { timeout 900 du -x -h -d 2 "$r" 2>/dev/null | sort -k2 >"$V/trees/$name.sizes" || true; }
  done <"$d/data-roots.txt"
}

snap_users() {
  local d=$S/users home f; mkdir -p "$d"
  getent passwd | awk -F: '($3>=1000 && $3<60000) || $3==0' >"$d/users.passwd"
  getent group | awk -F: '($3>=1000 && $3<60000) || $4!=""' >"$d/groups.group"
  while IFS=: read -r _ _ _ _ _ home _; do
    [[ -d $home ]] || continue
    for f in $HOME_FILES; do grab "$home/$f"; done
  done <"$d/users.passwd"
}

snap_scripts() {
  local d=$S/scripts g p; mkdir -p "$d"
  local -a dirs=()
  for g in $SCRIPT_DIRS; do for p in $g; do [[ -e $p ]] && dirs+=("$p"); done; done
  ((${#dirs[@]})) && GRAB_DEPTH=3 grab -l "${dirs[@]}"
  py referenced-paths "$FILES" "$MAX_FILE_KB" >"$d/referenced.txt" || true
  while read -r p; do [[ -n $p ]] && grab "$p"; done <"$d/referenced.txt"
  # shellcheck disable=SC2086
  [[ -n $EXTRA_CAPTURE ]] && GRAB_DEPTH=8 grab -l $EXTRA_CAPTURE
  {
    for p in "${dirs[@]}"; do [[ -d $p ]] && find "$p" -maxdepth 3 -type f -size -"${MAX_FILE_KB}"k 2>/dev/null; done
    cat "$d/referenced.txt"
  } | sort -u | while read -r p; do
    [[ -f $p ]] && head -c 2 "$p" 2>/dev/null | grep -q '#!' || continue
    # skip auto-generated pip/console-script entry points and package-owned files
    head -n 8 "$p" 2>/dev/null | grep -qE '^from [A-Za-z0-9_.]+ import |^# EASY-INSTALL|load_entry_point' && head -1 "$p" | grep -q python && continue
    have dpkg && dpkg -S "$p" >/dev/null 2>&1 && continue
    echo "$p"
  done >"$d/index.txt" || true
  [[ -s $d/referenced.txt ]] || rm -f "$d/referenced.txt"
}

snap_incus() {
  have incus || return 0
  incus list >/dev/null 2>&1 || return 0
  local d=$S/incus i; mkdir -p "$d/instances"
  cap "$d/preseed.yaml" incus admin init --dump
  cap "$V/incus-list.txt" incus list -c nstS4 -f compact
  for i in $(incus list -c n -f csv 2>/dev/null); do
    cap "$d/instances/$i.yaml" bash -c "incus config show '$i' 2>/dev/null | grep -vE '^\s*volatile\.'"
    cap "$d/instances/$i.snapshots" bash -c "incus snapshot list '$i' -f csv -c n 2>/dev/null"
  done
  rmdir "$d/instances" 2>/dev/null || true
}

snap_monitoring() {
  local d=$S/monitoring; mkdir -p "$d"
  # Which scripts / cron jobs / units push to Uptime Kuma or ping healthchecks.io (read-only scan)
  py integrations "$FILES" >"$d/integrations.json" || true
  # Uptime Kuma's own monitor list, read-only from its SQLite DB (located via the container's /app/data mount)
  [[ -s $S/docker/containers.json ]] && py kuma-inventory "$S/docker/containers.json" >"$d/kuma-monitors.json" 2>"$V/kuma-inventory.err" || true
  [[ -s $d/kuma-monitors.json ]] || rm -f "$d/kuma-monitors.json"
  [[ $(cat "$d/integrations.json" 2>/dev/null) == "[]" ]] && rm -f "$d/integrations.json"
  rmdir "$d" 2>/dev/null || true
}

# ----------------------------------------------------------------------------
# git history / context
# ----------------------------------------------------------------------------
git_s() { git -C "$STATE_DIR" -c user.name=serverstate -c user.email=serverstate@localhost "$@"; }

init_state_dir() {
  mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"
  have git || { warn "git not installed — change history disabled (apt install git)"; return 0; }
  [[ -d $STATE_DIR/.git ]] || { git_s init -q; }
  printf '%s\n' volatile/ CONTEXT.md audit.md bundles/ '.stage.*' '*.old' .last-push >"$STATE_DIR/.gitignore"
}

commit_state() {
  have git || return 0
  git_s add -A
  git_s diff --cached --quiet && { CHANGED=0; return 0; }
  CHANGED=1
  local subject body old
  if git_s rev-parse -q --verify HEAD >/dev/null; then
    subject=$(git_s diff --cached --name-only | awk -F/ '
      $1=="snapshot" && $2=="files" { sub(/^snapshot\/files/, ""); f[++n]=$0; next }
      $2=="files.manifest.tsv" {next}
      $1=="snapshot" { a[$2]=1; next } { a[$1]=1 }
      END { s=""; for (k in a) s=s (s?", ":"") k;
            for (i=1;i<=n && i<=4;i++) s=s (s?", ":"") "/" substr(f[i],2);
            if (n>4) s=s " +" (n-4) " files"; print s }')
    old=$(mktemp)
    git_s show HEAD:snapshot/docker/containers.json >"$old" 2>/dev/null || echo '[]' >"$old"
    body=$( { py docker-diff "$old" "$STATE_DIR/snapshot/docker/containers.json" 2>/dev/null || true
              git_s diff --cached --name-status | grep -v 'files.manifest.tsv' | sed 's#snapshot/files/#/#' | head -60; } )
    rm -f "$old"
    git_s commit -q -m "changed: ${subject:-misc}" -m "$body"
  else
    git_s commit -q -m "initial snapshot of $(hostname)"
  fi
}

gen_context() {
  mkdir -p "$STATE_DIR/volatile"
  if have git && git_s rev-parse -q --verify HEAD >/dev/null; then
    git_s log -n 25 --date=format:'%Y-%m-%d %H:%M' --pretty='### %ad — %s%n%b' >"$STATE_DIR/volatile/changelog.txt" 2>/dev/null || true
  fi
  py notes-stubs "$STATE_DIR" || warn "could not update NOTES.md stubs"
  py context "$STATE_DIR" "$BACKUP_PATHS" "$RCLONE_REMOTE" "$([[ -r $PASSPHRASE_FILE ]] && echo yes || echo no)" >"$STATE_DIR/CONTEXT.md.tmp"
  mv "$STATE_DIR/CONTEXT.md.tmp" "$STATE_DIR/CONTEXT.md"
  local c owner
  for c in $CONTEXT_COPIES; do
    mkdir -p "$(dirname "$c")" 2>/dev/null || continue
    owner=$(stat -c '%U:%G' "$(dirname "$c")")
    install -m 644 -o "${owner%%:*}" -g "${owner##*:}" "$STATE_DIR/CONTEXT.md" "$c" 2>/dev/null || warn "could not write $c"
  done
}

# ----------------------------------------------------------------------------
# commands
# ----------------------------------------------------------------------------
cmd_snapshot() {
  local push=no a
  for a in "$@"; do case $a in --quiet|-q) QUIET=1;; --push) push=yes;; --auto-push) push=auto;; *) die "unknown option $a";; esac; done
  need_root snapshot
  have python3 || die "python3 is required"
  exec 9>/run/serverstate.lock
  flock -n 9 || { info "another snapshot is running — skipping"; return 0; }
  init_state_dir
  build_exprs
  local stage; stage=$(mktemp -d "$STATE_DIR/.stage.XXXXXX")
  S=$stage/snapshot V=$stage/volatile FILES=$stage/snapshot/files MANIFEST=$stage/snapshot/files.manifest.tsv
  mkdir -p "$S" "$V" "$FILES"; : >"$MANIFEST"
  log "Capturing server state ($(hostname))"
  section meta snap_meta
  section packages snap_packages
  section etc snap_etc
  section users+home snap_users
  section storage snap_storage
  section network snap_network
  section firewall snap_firewall
  section systemd snap_systemd
  section cron snap_cron
  section docker snap_docker
  section scripts snap_scripts
  section incus snap_incus
  section monitoring snap_monitoring
  sort -u -t$'\t' -k4 -o "$MANIFEST" "$MANIFEST"
  date -Iseconds >"$V/captured-at"
  rm -rf "$STATE_DIR/snapshot.old" "$STATE_DIR/volatile.old"
  [[ -d $STATE_DIR/snapshot ]] && mv "$STATE_DIR/snapshot" "$STATE_DIR/snapshot.old"
  [[ -d $STATE_DIR/volatile ]] && mv "$STATE_DIR/volatile" "$STATE_DIR/volatile.old"
  mv "$S" "$STATE_DIR/snapshot"; mv "$V" "$STATE_DIR/volatile"
  rm -rf "$stage" "$STATE_DIR/snapshot.old" "$STATE_DIR/volatile.old"
  CHANGED=1
  py notes-stubs "$STATE_DIR" || warn "could not update NOTES.md stubs"
  commit_state
  gen_context
  if ((CHANGED)); then ok "snapshot saved — changes recorded"; else ok "snapshot saved — no config changes"; fi
  info "context: $STATE_DIR/CONTEXT.md"
  exec 9>&-
  case $push in
    yes) if [[ -n $RCLONE_REMOTE ]]; then cmd_push; else warn "RCLONE_REMOTE not set in $CONF — bundle not uploaded"; fi ;;
    auto) [[ $AUTO_PUSH == yes && -n $RCLONE_REMOTE ]] && cmd_push --auto ;;
  esac
  return 0
}

cmd_context() { need_root context; gen_context; ok "$STATE_DIR/CONTEXT.md regenerated"; }

cmd_notes() {
  need_root notes
  init_state_dir
  py notes-stubs "$STATE_DIR"
  "${EDITOR:-nano}" "$STATE_DIR/NOTES.md"
  if have git; then git_s add NOTES.md; git_s diff --cached --quiet || git_s commit -q -m "notes updated"; fi
  gen_context; ok "notes saved and CONTEXT.md regenerated"
}

make_bundle() { # make_bundle OUTFILE
  local out=$1 sd=${STATE_DIR#/} ld=${LIB_DIR#/}
  tar -czf "$out" -C / \
    --exclude="$sd/.stage.*" --exclude="$sd/bundles" --exclude="$sd/*.old" --exclude="__pycache__" \
    --transform "s|^$sd|state|" --transform "s|^$ld|tool|" \
    "$sd" "$ld"
}

cmd_push() {
  local force=0 auto=0 a
  for a in "$@"; do case $a in --force) force=1;; --auto) auto=1;; --quiet|-q) QUIET=1;; esac; done
  need_root push
  [[ -n $RCLONE_REMOTE ]] || die "RCLONE_REMOTE is not set in $CONF"
  have rclone || die "rclone not installed"
  local head="none" last="" now; now=$(date +%s)
  have git && head=$(git_s rev-parse -q --verify HEAD 2>/dev/null || echo none)
  [[ -r $STATE_DIR/.last-push ]] && last=$(cat "$STATE_DIR/.last-push")
  if ((!force)) && [[ ${last%% *} == "$head" ]]; then info "bundle unchanged since last push — skipping upload"; return 0; fi
  if ((auto)) && [[ -n $last ]] && (( now - ${last##* } < AUTO_PUSH_MIN_INTERVAL )); then info "pushed recently — next auto-push later"; return 0; fi
  local tmp ext=tar.gz host ts; tmp=$(mktemp -d); host=$(hostname -s); ts=$(date +%Y%m%d-%H%M%S)
  make_bundle "$tmp/b.tar.gz"
  if [[ -r $PASSPHRASE_FILE ]]; then
    openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -in "$tmp/b.tar.gz" -out "$tmp/b.tar.gz.enc" -pass "file:$PASSPHRASE_FILE"
    rm -f "$tmp/b.tar.gz"; ext=tar.gz.enc
  else
    warn "no $PASSPHRASE_FILE — bundle is NOT encrypted (it contains secrets: .env files, keys, shadow)"
  fi
  log "Uploading state bundle to $RCLONE_REMOTE"
  # shellcheck disable=SC2086
  {
    rclone copyto $RCLONE_FLAGS "$tmp/b.$ext" "$RCLONE_REMOTE/bundles/$host-$ts.$ext" &&
    rclone copyto $RCLONE_FLAGS "$tmp/b.$ext" "$RCLONE_REMOTE/latest.$ext" &&
    rclone copyto $RCLONE_FLAGS "$LIB_DIR/bootstrap.sh" "$RCLONE_REMOTE/bootstrap.sh"
  } || { rm -rf "$tmp"; die "upload failed"; }
  # shellcheck disable=SC2086
  rclone delete $RCLONE_FLAGS --min-age "${KEEP_REMOTE_DAYS}d" "$RCLONE_REMOTE/bundles" 2>/dev/null || true
  local other; other=$([[ $ext == tar.gz ]] && echo tar.gz.enc || echo tar.gz)
  # shellcheck disable=SC2086
  rclone deletefile $RCLONE_FLAGS "$RCLONE_REMOTE/latest.$other" 2>/dev/null || true
  echo "$head $now" >"$STATE_DIR/.last-push"
  rm -rf "$tmp"
  ok "pushed $RCLONE_REMOTE/latest.$ext ($(date))"
}

extract_bundle() { # extract_bundle FILE DESTDIR
  local f=$1 dest=$2 pass
  mkdir -p "$dest"
  if [[ $f == *.enc ]]; then
    if [[ -r $PASSPHRASE_FILE ]]; then pass=$(cat "$PASSPHRASE_FILE")
    else read -rsp "Bundle passphrase: " pass </dev/tty; echo >&2; fi
    SS_PASS=$pass openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -in "$f" -pass env:SS_PASS | tar -xzf - -C "$dest" \
      || die "decryption failed (wrong passphrase?)"
    (umask 077; printf '%s' "$pass" >"$dest/.passphrase")
  else
    tar -xzf "$f" -C "$dest"
  fi
}

cmd_pull() {
  need_root pull
  local remote=${1:-$RCLONE_REMOTE} dest f
  [[ -n $remote ]] || die "usage: serverstate pull r2:bucket/path"
  have rclone || die "install rclone first: curl https://rclone.org/install.sh | sudo bash"
  dest=/root/serverstate-restore/$(date +%Y%m%d-%H%M%S); mkdir -p "$dest"
  if rclone lsf "$remote/latest.tar.gz.enc" 2>/dev/null | grep -q .; then f=latest.tar.gz.enc; else f=latest.tar.gz; fi
  rclone copyto "$remote/$f" "$dest/$f" || die "could not download $remote/$f"
  extract_bundle "$dest/$f" "$dest"
  ok "bundle extracted to $dest"
  info "captured from: $(cat "$dest/state/snapshot/meta/hostname" 2>/dev/null) at $(cat "$dest/state/volatile/captured-at" 2>/dev/null)"
  info "next:  $dest/tool/serverstate restore --bundle $dest --dry-run"
  info "then:  $dest/tool/serverstate restore --bundle $dest"
}

cmd_log() { have git || die "git not installed"; git_s log --date=format:'%Y-%m-%d %H:%M' --pretty='%C(yellow)%ad%Creset %s' -n "${1:-40}"; }
cmd_diff() { have git || die "git not installed"; git_s show --stat --patch "${1:-HEAD}" -- . ':!snapshot/files.manifest.tsv' | ${PAGER:-less -R}; }

cmd_status() {
  echo "serverstate $SS_VERSION   config: $CONF   state: $STATE_DIR"
  echo "last snapshot : $(cat "$STATE_DIR/volatile/captured-at" 2>/dev/null || echo never)"
  if [[ -r $STATE_DIR/.last-push ]]; then echo "last push     : $(date -d "@$(cut -d' ' -f2 "$STATE_DIR/.last-push")")  -> ${RCLONE_REMOTE}"; else echo "last push     : never (${RCLONE_REMOTE:-RCLONE_REMOTE not set})"; fi
  echo "encryption    : $([[ -r $PASSPHRASE_FILE ]] && echo "on ($PASSPHRASE_FILE)" || echo OFF)"
  echo "timer         : $(systemctl is-active serverstate-snapshot.timer 2>/dev/null || true)"
  echo "watcher       : $(systemctl is-active serverstate-watch.service 2>/dev/null || true)"
  echo "context copies: ${CONTEXT_COPIES:-none}"
  [[ -r $STATE_DIR/CONTEXT.md ]] && grep -E '^- ⚠' "$STATE_DIR/CONTEXT.md" | head -20 || true
}

cmd_watch() {
  need_root watch
  local -a rec=() flat=() ; local p g
  for p in /etc /var/spool/cron; do [[ -d $p ]] && rec+=("$p"); done
  for g in $SCRIPT_DIRS; do for p in $g; do [[ -d $p ]] && rec+=("$p"); done; done
  if [[ -r $STATE_DIR/snapshot/docker/compose-projects.json ]]; then
    while IFS=$'\t' read -r k p; do [[ $k == dir && -d $p ]] && flat+=("$p"); done < <(py compose-paths "$STATE_DIR/snapshot/docker/compose-projects.json")
  fi
  local sources=0
  have docker && sources=1
  have inotifywait && sources=1 || warn "inotify-tools not installed — only docker changes trigger snapshots"
  ((sources)) || { warn "nothing to watch"; exec sleep infinity; }
  log "watching docker events + ${#rec[@]} dirs (recursive) + ${#flat[@]} compose dirs; debounce ${WATCH_DEBOUNCE}s"
  {
    have docker && docker events --filter type=container --filter type=network --filter type=volume \
      --filter event=create --filter event=destroy --format '{{.Type}} {{.Action}} {{.Actor.Attributes.name}}' &
    if have inotifywait; then
      inotifywait -m -q -r -e close_write,create,delete,moved_to,moved_from --format '%w%f' \
        --exclude '(\.swp|~|\.tmp|\.lock|/etc/mtab|ld\.so\.cache|/etc/resolv\.conf)$' "${rec[@]}" &
      ((${#flat[@]})) && inotifywait -m -q -e close_write,create,delete,moved_to --format '%w%f' "${flat[@]}" &
    fi
    wait
  } | {
    local pending=0 first=0 line now
    while :; do
      if IFS= read -r -t "$WATCH_DEBOUNCE" line; then
        ((pending)) || first=$(date +%s); pending=1
        now=$(date +%s); (( now - first < 900 )) && continue
      else
        (( $? > 128 )) || break
        ((pending)) || continue
      fi
      pending=0
      "$SELF" snapshot --quiet --auto-push || warn "auto-snapshot failed"
    done
  }
}

cmd_audit() {
  need_root audit
  [[ -d $STATE_DIR/snapshot ]] || cmd_snapshot --quiet
  build_exprs
  local tmp r; tmp=$(mktemp -d)
  log "Coverage audit — sizing directories (read-only, low IO priority; can take a few minutes on big HDDs)"
  {
    for r in /opt /srv /var/lib /root /home $(data_roots); do
      [[ -d $r ]] || continue
      timeout 900 nice -n 19 ionice -c3 du -x -B1 -d 2 "$r" 2>/dev/null || true
    done
  } | sort -u -k2 >"$tmp/du.tsv"
  if have docker && docker info >/dev/null 2>&1; then
    info "· docker sizes and images"
    docker ps -as --format '{{.Names}}\t{{.Size}}' >"$tmp/docker-size.tsv" 2>/dev/null || true
    docker image ls --digests --format '{{.Repository}}\t{{.Tag}}\t{{.Digest}}\t{{.Size}}' >"$tmp/images.tsv" 2>/dev/null || true
  fi
  have dkms && dkms status >"$tmp/dkms.txt" 2>/dev/null || true
  info "· package-owned files / changed package configs"
  stat -c %Y /var/log/installer /etc/machine-id 2>/dev/null | sort -n | head -1 >"$tmp/install-time" || true
  py audit "$STATE_DIR" "$BACKUP_PATHS" "$tmp" "$RESTORE_ETC_PATHS" >"$STATE_DIR/audit.md"
  rm -rf "$tmp"
  gen_context
  ok "audit written: $STATE_DIR/audit.md (also included in CONTEXT.md)"
  grep -E '^## |^- ✗' "$STATE_DIR/audit.md" | head -40 >&2 || true
}

cmd_uninstall() {
  need_root uninstall
  exec bash "$LIB_DIR/uninstall.sh" "$@"
}

cmd_hook_backup() {
  need_root hook-backup
  local script=${1:-}
  [[ -f $script ]] || die "usage: serverstate hook-backup /path/to/your/backup-script.sh"
  grep -q 'serverstate snapshot' "$script" && { ok "already hooked"; return 0; }
  cp -p "$script" "$script.pre-serverstate"
  local line='/usr/local/sbin/serverstate snapshot --quiet --push || echo "serverstate snapshot failed (continuing backup)" >&2'
  awk -v l="$line" 'NR==1 && /^#!/ {print; print "# serverstate: capture full server config (and push bundle) before backing up"; print l; next}
                    NR==1 {print "# serverstate: capture full server config (and push bundle) before backing up"; print l}
                    {print}' "$script.pre-serverstate" >"$script"
  [[ -w $LIB_DIR ]] && echo "hook $script" >>"$LIB_DIR/install-manifest"
  ok "hooked $script (original saved as $script.pre-serverstate; 'serverstate uninstall' removes the hook)"
  info "Also make sure $STATE_DIR is inside the paths your backup uploads."
}

cmd_final_backup() {
  need_root final-backup
  log "Cutover backup: snapshot -> stop containers -> backup -> push"
  cmd_snapshot
  if have docker && [[ -n $(docker ps -q) ]]; then
    log "Stopping running containers for a consistent data backup (state already recorded)"
    docker ps -q | xargs -r docker stop -t 60 >/dev/null
  fi
  if [[ -n $BACKUP_CMD ]]; then log "Running backup: $BACKUP_CMD"; bash -c "$BACKUP_CMD" || die "backup command failed"
  else warn "BACKUP_CMD not set in $CONF — run your backup manually now"; read -rp "Press Enter when the backup has finished… " _ </dev/tty; fi
  [[ -n $RCLONE_REMOTE ]] && cmd_push --force
  ok "Old server quiesced and backed up."
  info "Disable its backup cron job / timer now so it doesn't overwrite the new server's backups later."
}

# ----------------------------------------------------------------------------
# RESTORE
# ----------------------------------------------------------------------------
PHASES=(preflight packages users home storage dirs data docker-engine config scripts docker systemd cron firewall verify)
declare -A PHASE_DESC=(
  [preflight]="compare old/new machine, install base tools"
  [packages]="apt repos+keys, apt manual packages, snaps, pipx, npm -g"
  [users]="users, groups (same UIDs/GIDs), password hashes"
  [home]="dotfiles, ~/.ssh, rclone/restic configs, ~/bin"
  [storage]="interactive: map old mounts to new disks, fstab, RAID/ZFS/LVM"
  [dirs]="recreate SSD/HDD directory trees with owners & permissions"
  [data]="restore data from your backup (BACKUP_RESTORE_CMD)"
  [docker-engine]="install docker + compose, restore daemon.json"
  [config]="selected /etc configs (ssh, sysctl, fail2ban, ufw, wireguard…), hostname, timezone"
  [scripts]="scripts in /usr/local/bin etc. and everything cron/systemd call"
  [docker]="docker networks (same subnets), compose stacks up, standalone containers"
  [systemd]="custom units, re-enable services that were enabled"
  [cron]="all user crontabs and /etc/cron.*"
  [firewall]="ufw / nftables / iptables / fail2ban with auto-rollback safety"
  [verify]="compare containers, ports, mounts; install serverstate here"
)

ask() { # ask QUESTION y|n
  ((ASSUME_YES)) && return 0
  local a hint; [[ $2 == y ]] && hint="Y/n" || hint="y/N"
  read -r -p "  $1 [$hint] " a </dev/tty || a=""
  a=${a:-$2}; [[ $a =~ ^[Yy] ]]
}
prompt() { local a; read -r -p "  $1 " a </dev/tty || a=""; printf '%s' "$a"; }
act() {
  if ((DRY)); then printf '    [dry-run]'; printf ' %q' "$@"; printf '\n'; return 0; fi
  "$@"
}
act_append() { # act_append FILE LINE
  if ((DRY)); then printf '    [dry-run] append to %s: %s\n' "$1" "$2"; return 0; fi
  printf '%s\n' "$2" >>"$1"
}
restore_path() { # restore_path /abs/path [extra rsync opts] — copy from bundle to live, keeping .pre-serverstate backups
  local p=$1; shift
  local src="$BF$p"
  [[ -e $src || -L $src ]] || return 0
  act mkdir -p "$(dirname "$p")"
  if [[ -d $src && ! -L $src ]]; then act rsync -a --backup --suffix=.pre-serverstate "$@" "$src/" "$p/"
  else act rsync -a --backup --suffix=.pre-serverstate "$@" "$src" "$p"; fi
}
apt_install() { act env DEBIAN_FRONTEND=noninteractive apt-get install -y -q "$@"; }

restore_preflight() {
  local oldos newos
  echo "  Source machine : $(cat "$SNAP/meta/hostname" 2>/dev/null)  captured $(cat "$VOL/captured-at" 2>/dev/null)"
  oldos=$(. "$SNAP/meta/os-release" 2>/dev/null; echo "$PRETTY_NAME")
  newos=$(. /etc/os-release; echo "$PRETTY_NAME")
  echo "  Source OS      : $oldos"
  echo "  This machine   : $(hostname) — $newos"
  [[ $oldos == "$newos" ]] || warn "OS differs — package names/repos may not match exactly; review the packages phase output"
  echo "  Containers: $(py count containers "$SNAP")  stacks: $(py count projects "$SNAP")  cron lines: $(cat "$SNAP"/cron/user-*.crontab 2>/dev/null | grep -cvE '^\s*(#|$)' || true)  custom units: $(grep -cv '\.conf$' "$SNAP/systemd/custom-units.txt" 2>/dev/null || echo 0)"
  if have apt-get; then act apt-get update -q; apt_install rsync python3 curl ca-certificates gnupg git openssl; fi
}

restore_packages() {
  local fam; fam=$(cat "$SNAP/packages/family" 2>/dev/null || echo unknown)
  if [[ $fam == debian ]] && have apt-get; then
    local oldcode newcode; oldcode=$(. "$SNAP/meta/os-release"; echo "${VERSION_CODENAME:-}"); newcode=$(. /etc/os-release; echo "${VERSION_CODENAME:-}")
    if [[ $oldcode == "$newcode" ]] || ask "Old release '$oldcode' ≠ this '$newcode'. Copy apt sources anyway?" n; then
      restore_path /etc/apt/sources.list.d
      restore_path /etc/apt/keyrings
      restore_path /etc/apt/trusted.gpg.d
      restore_path /etc/apt/preferences.d
      restore_path /usr/share/keyrings --ignore-existing
      [[ $oldcode == "$newcode" ]] && restore_path /etc/apt/sources.list
    else
      info "kept this machine's apt sources; third-party repos are in $BF/etc/apt/sources.list.d for manual review"
    fi
    act apt-get update -q || warn "apt-get update reported errors (a third-party repo may need attention)"
    local want avail missing
    want=$(grep -vE '^(linux-(image|headers|modules|generic|virtual|firmware|signed|hwe)|grub|shim|efibootmgr|intel-microcode|amd64-microcode|cloud-init|cloud-guest)' "$SNAP/packages/apt-manual.txt" 2>/dev/null | sort -u)
    avail=$(apt-cache pkgnames 2>/dev/null | sort -u)
    missing=$(comm -23 <(echo "$want") <(echo "$avail") | grep . || true)
    mapfile -t pk < <(comm -12 <(echo "$want") <(echo "$avail") | grep .)
    info "installing ${#pk[@]} apt packages"
    if ((${#pk[@]})) && ! apt_install "${pk[@]}"; then
      warn "bulk install failed — retrying one by one"
      local p; for p in "${pk[@]}"; do apt_install "$p" >/dev/null 2>&1 || warn "  could not install $p"; done
    fi
    [[ -n $missing ]] && warn "not available in this machine's repos: $(echo $missing)"
    [[ -s $SNAP/packages/apt-hold.txt ]] && act apt-mark hold $(cat "$SNAP/packages/apt-hold.txt")
  elif [[ $fam == rhel ]] && have dnf; then
    mapfile -t pk <"$SNAP/packages/dnf-userinstalled.txt"
    act dnf install -y --skip-broken "${pk[@]}" || true
  fi
  if [[ -s $SNAP/packages/snap.txt ]] && have snap; then
    local name ch notes
    while IFS=$'\t' read -r name ch notes; do
      [[ $name =~ ^(core[0-9]*|snapd|bare|gtk-common-themes|gnome-.*)$ ]] && continue
      snap list "$name" >/dev/null 2>&1 && continue
      act snap install "$name" ${ch:+--channel="$ch"} $([[ $notes == *classic* ]] && echo --classic) || warn "snap $name failed"
    done <"$SNAP/packages/snap.txt"
  fi
  if [[ -s $SNAP/packages/pipx.txt ]]; then
    have pipx || apt_install pipx || true
    have pipx && while read -r p _; do [[ -n $p ]] && { act pipx install "$p" || true; }; done <"$SNAP/packages/pipx.txt"
  fi
  if [[ -s $SNAP/packages/npm-global.txt ]] && have npm; then
    mapfile -t pk <"$SNAP/packages/npm-global.txt"
    mapfile -t pk < <(printf '%s\n' "${pk[@]}" | grep -vxE 'npm|corepack')
    ((${#pk[@]})) && { act npm install -g "${pk[@]}" || true; }
  fi
  [[ -s $SNAP/packages/pip3-freeze.txt ]] && info "pip packages (system-wide) listed in $SNAP/packages/pip3-freeze.txt — reinstall into venvs as needed"
  if [[ -s $SNAP/packages/usr-local-bin.txt ]]; then
    local bins; bins=$(awk -F'\t' '$2 !~ /script|text|symbolic/ {print $1}' "$SNAP/packages/usr-local-bin.txt" | while read -r b; do [[ -e $BF$b ]] || basename "$b"; done | xargs)
    [[ -n $bins ]] && warn "manually installed binaries to reinstall yourself (not captured): $bins"
  fi
}

restore_users() {
  local name pw uid gid gecos home shell gname gpw ggid members u
  while IFS=: read -r gname gpw ggid members; do
    getent group "$gname" >/dev/null && continue
    if getent group "$ggid" >/dev/null; then warn "gid $ggid taken — creating group $gname with a new gid"; act groupadd "$gname"
    else act groupadd -g "$ggid" "$gname"; fi
  done < <(awk -F: '$3>=1000' "$SNAP/users/groups.group")
  while IFS=: read -r name pw uid gid gecos home shell; do
    [[ $uid == 0 ]] && continue
    if id "$name" >/dev/null 2>&1; then
      [[ $(id -u "$name") == "$uid" ]] || warn "user $name exists with uid $(id -u "$name") (was $uid) — file ownership may need chown"
    else
      if getent passwd "$uid" >/dev/null; then warn "uid $uid taken — skipping user $name"; continue; fi
      getent group "$gid" >/dev/null || act groupadd -g "$gid" "$name"
      act useradd -u "$uid" -g "$gid" -d "$home" -m -s "$shell" -c "$gecos" "$name"
    fi
    local hash; hash=$(awk -F: -v u="$name" '$1==u {print $2}' "$BF/etc/shadow" 2>/dev/null)
    [[ -n $hash && $hash != '!'* && $hash != '*' ]] && act usermod -p "$hash" "$name"
  done <"$SNAP/users/users.passwd"
  while IFS=: read -r gname gpw ggid members; do
    [[ -z $members ]] && continue
    getent group "$gname" >/dev/null || continue
    for u in ${members//,/ }; do
      id "$u" >/dev/null 2>&1 || continue
      id -nG "$u" | tr ' ' '\n' | grep -qx "$gname" && continue
      act usermod -aG "$gname" "$u"
    done
  done <"$SNAP/users/groups.group"
}

restore_home() {
  local name home
  while IFS=: read -r name _ _ _ _ home _; do
    [[ -d $BF$home ]] || continue
    info "$name: $home"
    restore_path "$home"
  done <"$SNAP/users/users.passwd"
}

restore_storage() {
  [[ -r /dev/tty ]] || { warn "storage phase needs an interactive terminal — skipped"; return 0; }
  echo; echo "  OLD machine disks:"; py lsblk-table "$SNAP/storage/lsblk.json" | sed 's/^/    /'
  echo; echo "  THIS machine:"; lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MODEL,ROTA,MOUNTPOINT -e7 | sed 's/^/    /'
  if [[ -s $SNAP/storage/mdadm-scan.txt ]]; then
    echo; echo "  Old mdadm arrays:"; sed 's/^/    /' "$SNAP/storage/mdadm-scan.txt"
    have mdadm || apt_install mdadm
    ask "Assemble existing arrays now (mdadm --assemble --scan)? (only if you moved those disks over)" n && { act mdadm --assemble --scan || true; }
  fi
  if [[ -s $SNAP/storage/zpool-list.txt ]]; then
    echo; echo "  Old ZFS pools:"; sed 's/^/    /' "$SNAP/storage/zpool-list.txt"
    have zpool || apt_install zfsutils-linux
    if ask "Import the old pools (disks moved over)? (zpool import -f <pool>)" n; then
      local pool; while read -r pool _; do act zpool import -f "$pool" || warn "could not import $pool"; done <"$SNAP/storage/zpool-list.txt"
    fi
  fi
  if [[ -s $SNAP/storage/lvm.txt ]] && have vgchange; then ask "Activate LVM volume groups (vgchange -ay)?" y && act vgchange -ay; fi

  act cp /etc/fstab "/etc/fstab.pre-serverstate.$(date +%s)"
  local src target fstype opts dump pass dev devpath curfs uuid label newopts confirm
  while read -r src target fstype opts dump pass; do
    case $target in /|/boot|/boot/efi|none|swap) continue ;; esac
    [[ $fstype == swap ]] && continue
    if awk -v t="$target" '$1 !~ /^#/ && $2==t {f=1} END{exit !f}' /etc/fstab; then info "$target already in fstab — skipping"; continue; fi
    echo; echo "  ── $target   (old: $src  $fstype  $opts)"
    echo "     old device: $(py lsblk-find "$SNAP/storage/lsblk.json" "$src")"
    case $fstype in
      nfs*|cifs|smb*|fuse.*|9p|sshfs|zfs)
        if ask "Network/pooled mount — add this fstab line as-is?" y; then act mkdir -p "$target"; act_append /etc/fstab "$src $target $fstype $opts ${dump:-0} ${pass:-0}"; fi
        continue ;;
    esac
    if [[ $src == UUID=* ]] && blkid -U "${src#UUID=}" >/dev/null 2>&1; then
      echo "     ✓ the SAME filesystem is present here ($(blkid -U "${src#UUID=}")) — disk was moved over"
      if ask "Keep the original fstab line?" y; then act mkdir -p "$target"; act_append /etc/fstab "$src $target $fstype $opts ${dump:-0} ${pass:-0}"; continue; fi
    fi
    while :; do
      dev=$(prompt "Device for $target here (e.g. /dev/sdb1 or UUID=…), 'l' = list disks, Enter = skip:")
      [[ $dev == l ]] && { lsblk -o NAME,SIZE,TYPE,FSTYPE,LABEL,MODEL,MOUNTPOINT -e7; continue; }
      break
    done
    [[ -z $dev ]] && { info "skipped $target"; continue; }
    case $dev in UUID=*) devpath=$(blkid -U "${dev#UUID=}" || true) ;; LABEL=*) devpath=$(blkid -L "${dev#LABEL=}" || true) ;; *) devpath=$dev ;; esac
    [[ -b $devpath ]] || { warn "$dev is not a block device — skipped $target"; continue; }
    curfs=$(blkid -o value -s TYPE "$devpath" 2>/dev/null || true)
    if [[ -z $curfs ]]; then
      label=$(py lsblk-label "$SNAP/storage/lsblk.json" "$src")
      confirm=$(prompt "$devpath has no filesystem. Type  FORMAT $devpath  to create $fstype${label:+ (label $label)} — THIS ERASES IT — or Enter to skip:")
      [[ $confirm == "FORMAT $devpath" ]] || { info "skipped $target"; continue; }
      if [[ $fstype == vfat ]]; then act mkfs -t vfat ${label:+-n "$label"} "$devpath"; else act mkfs -t "$fstype" ${label:+-L "$label"} "$devpath"; fi
      ((DRY)) && { info "(dry-run) would add fstab line for $target"; continue; }
    elif [[ $curfs != "$fstype" ]]; then
      warn "$devpath already has $curfs (old was $fstype)"
      ask "Use it as-is (no formatting)?" n || continue
      fstype=$curfs
    fi
    uuid=$(blkid -o value -s UUID "$devpath" 2>/dev/null || true)
    [[ -n $uuid ]] || { warn "no UUID on $devpath — skipped"; continue; }
    newopts=$opts; [[ $newopts == *nofail* ]] || newopts="$newopts,nofail"
    act mkdir -p "$target"
    act_append /etc/fstab "UUID=$uuid $target $fstype $newopts ${dump:-0} ${pass:-0}"
  done < <(grep -vE '^\s*(#|$)' "$BF/etc/fstab")
  act systemctl daemon-reload
  act mount -a || warn "mount -a reported errors — check /etc/fstab"
  # mergerfs-style pools may depend on branch mounts above; second pass
  act mount -a 2>/dev/null || true
  findmnt -rn -o TARGET,SOURCE,FSTYPE | grep -vE '^/(proc|sys|dev|run|snap)' | sed 's/^/    /' | head -40
}

restore_dirs() {
  local f root n created
  for f in "$VOL"/trees/*.tsv; do
    [[ -s $f ]] || continue
    root=$(head -1 "$f" | cut -f4)
    [[ -d $root ]] || { warn "$root does not exist here (mount it first) — skipping its tree"; continue; }
    n=$(while IFS=$'\t' read -r _ _ _ p; do [[ -d $p ]] || echo; done <"$f" | wc -l)
    ((n)) || { ok "$root: structure already complete"; continue; }
    ask "Recreate $n missing directories under $root (with original owner/perms)?" y || continue
    if ((DRY)); then info "(dry-run) would create $n directories under $root"; continue; fi
    created=0
    while IFS=$'\t' read -r mode user group p; do
      [[ -d $p ]] && continue
      mkdir -p "$p" && chown "$user:$group" "$p" 2>/dev/null; chmod "$mode" "$p" 2>/dev/null; created=$((created+1))
    done <"$f"
    ok "$root: created $created directories"
  done
}

restore_data() {
  echo "  Data locations the old server used (these come back from your backup, not from the bundle):"
  py data-locations "$SNAP" "$BACKUP_PATHS" | sed 's/^/    /'
  if [[ -n $BACKUP_RESTORE_CMD ]]; then
    echo "  Restore command: $BACKUP_RESTORE_CMD"
    ask "Run it now?" y && { act bash -c "$BACKUP_RESTORE_CMD" || die "restore command failed"; }
  else
    warn "BACKUP_RESTORE_CMD not set. Restore your data from R2 now (in another terminal), e.g. restic/rclone restore."
    info "You can stop here and continue later with:  serverstate restore --bundle $BUNDLE --from docker-engine"
    ask "Is the data restored — continue?" y || exit 0
  fi
}

restore_docker_engine() {
  if ! have docker; then
    if have apt-cache && apt-cache policy docker-ce 2>/dev/null | grep -q 'Candidate: [0-9]'; then
      apt_install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
    else
      act bash -c 'curl -fsSL https://get.docker.com | sh'
    fi
  fi
  restore_path /etc/docker
  local root; root=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("data-root",""))' "$BF/etc/docker/daemon.json" 2>/dev/null || true)
  [[ -n $root ]] && act mkdir -p "$root"
  act systemctl enable docker
  act systemctl restart docker
  docker compose version >/dev/null 2>&1 || apt_install docker-compose-plugin || warn "install the docker compose plugin manually"
}

restore_config() {
  local p
  for p in $RESTORE_ETC_PATHS; do [[ -e $BF$p ]] && { info "$p"; restore_path "$p"; }; done
  # /etc files that your custom units/scripts read (e.g. /etc/host-firewall/rules4.txt)
  while read -r p; do [[ -n $p && -e $BF$p ]] && { info "$p (used by your units/scripts)"; restore_path "$p"; }; done < <(py referenced-etc "$BF")
  local oldhost; oldhost=$(cut -d. -f1 "$SNAP/meta/hostname" 2>/dev/null)
  [[ -n $oldhost && $oldhost != "$(hostname -s)" ]] && ask "Set hostname to '$oldhost' (recommended for a seamless swap)?" y && act hostnamectl set-hostname "$oldhost"
  local tz; tz=$(cat "$SNAP/meta/timezone" 2>/dev/null)
  [[ -n $tz ]] && act timedatectl set-timezone "$tz"
  act sysctl --system >/dev/null || true
  if [[ -d /etc/sudoers.d ]] && have visudo && ! visudo -c >/dev/null 2>&1; then warn "sudoers validation FAILED — fix /etc/sudoers.d (backups: *.pre-serverstate) before logging out"; fi
  if have sshd; then
    if sshd -t 2>/dev/null; then
      echo "  ssh settings now: $(sshd -T 2>/dev/null | grep -E '^(port|permitrootlogin|passwordauthentication) ' | xargs)"
      ask "Reload sshd with restored config? (make sure your key is in ~/.ssh/authorized_keys — home phase restored it)" y \
        && { act systemctl reload ssh 2>/dev/null || act systemctl reload sshd; }
    else warn "sshd config test failed — not reloading. Check /etc/ssh/sshd_config*.pre-serverstate"; fi
  fi
  if [[ -d $BF/etc/netplan ]]; then
    act mkdir -p /root/serverstate-restore/netplan-old; act cp -a "$BF/etc/netplan/." /root/serverstate-restore/netplan-old/
    warn "network config NOT applied automatically (interface names differ between machines)."
    info "old interfaces:  $(awk '{print $1}' "$SNAP/network/links.txt" 2>/dev/null | xargs)   this machine: $(ip -br link | awk '{print $1}' | grep -vE '^(veth|br-|docker0)' | xargs)"
    info "old netplan copied to /root/serverstate-restore/netplan-old — adapt it (static IP etc.) then 'netplan try'"
  fi
}

restore_scripts() {
  local g p
  for g in $SCRIPT_DIRS; do
    for p in $BF$g; do [[ -e $p ]] && restore_path "${p#"$BF"}"; done
  done
  [[ -s $SNAP/scripts/referenced.txt ]] && while read -r p; do [[ -n $p ]] && restore_path "$p"; done <"$SNAP/scripts/referenced.txt"
  for p in $EXTRA_CAPTURE; do restore_path "$p"; done
}

restore_docker() {
  have docker || die "docker not installed (run the docker-engine phase)"
  local name cmd
  while IFS=$'\t' read -r name cmd; do
    docker network inspect "$name" >/dev/null 2>&1 && continue
    [[ $cmd == *macvlan* || $cmd == *ipvlan* ]] && warn "network $name uses macvlan/ipvlan — check the parent interface name matches this machine"
    act bash -c "$cmd" >/dev/null || warn "could not create network $name"
  done < <(py network-create-cmds "$SNAP/docker/networks.json")
  local proj wd files envs was f
  while IFS=$'\x1f' read -r proj wd files envs was; do
    if [[ $was != running ]]; then info "stack $proj was not running on the old server — files restored, not started"; fi
    if [[ -n $wd ]]; then
      if [[ -d $wd ]]; then restore_path "$wd" --ignore-existing; else restore_path "$wd"; fi
    fi
    local -a args=(-p "$proj")
    [[ -n $wd ]] && args+=(--project-directory "$wd")
    IFS='|' read -ra fl <<<"$files"
    for f in "${fl[@]}"; do [[ -n $f ]] || continue; [[ -e $f ]] || restore_path "$f"; args+=(-f "$f"); done
    IFS='|' read -ra el <<<"$envs"
    for f in "${el[@]}"; do [[ -n $f ]] || continue; [[ -e $f ]] || restore_path "$f"; [[ -e $f || $DRY == 1 ]] && args+=(--env-file "$f"); done
    [[ $was == running ]] || continue
    log "stack $proj"
    act docker compose "${args[@]}" pull -q --ignore-pull-failures 2>/dev/null || true
    act docker compose "${args[@]}" up -d || warn "stack $proj failed to start — see: docker compose ${args[*]} logs"
  done < <(py compose-restore-list "$SNAP/docker/compose-projects.json" "$VOL/docker-ps.tsv")
  local s
  for s in "$SNAP"/docker/standalone/*.sh; do
    [[ -f $s ]] || continue
    name=$(basename "$s" .sh)
    docker inspect "$name" >/dev/null 2>&1 && continue
    echo; sed 's/^/    /' "$s"
    ask "Recreate standalone container '$name' with the command above?" y && { act bash "$s" || warn "container $name failed"; }
  done
}

restore_systemd() {
  local f u
  local -a custom=()
  while read -r f; do
    [[ -n $f ]] || continue
    restore_path "$f"
    [[ $f == *.conf ]] || custom+=("$(basename "$f")")
  done <"$SNAP/systemd/custom-units.txt"
  act systemctl daemon-reload
  while read -r u; do
    [[ $u == *@.* || $u == snap* || $u == cloud-* || $u == getty* ]] && continue
    systemctl list-unit-files "$u" --no-legend 2>/dev/null | grep -q . || continue
    systemctl is-enabled --quiet "$u" 2>/dev/null && continue
    act systemctl enable "$u" 2>/dev/null || warn "could not enable $u"
  done <"$SNAP/systemd/enabled-units.txt"
  if ((${#custom[@]})); then
    echo "  custom units: ${custom[*]}"
    ask "Start enabled custom services/timers now?" y && for u in "${custom[@]}"; do
      grep -qx "$u" "$SNAP/systemd/enabled-units.txt" && { act systemctl restart "$u" || warn "$u failed to start"; }
    done
  fi
}

restore_cron() {
  local backups; backups=$(cat "$SNAP"/cron/user-*.crontab "$BF"/etc/crontab "$BF"/etc/cron.d/* 2>/dev/null | grep -vE '^\s*#' | grep -iE 'backup|restic|rclone|borg|kopia|r2' || true)
  if [[ -n $backups ]]; then
    warn "these backup jobs will start running on THIS machine:"; echo "$backups" | sed 's/^/      /'
    info "If the OLD server is still running its backup to the same bucket, disable one of them first."
    ask "Continue restoring cron?" y || return 0
  fi
  local f u
  for f in "$SNAP"/cron/user-*.crontab; do
    [[ -f $f ]] || continue
    u=${f##*/user-}; u=${u%.crontab}
    id "$u" >/dev/null 2>&1 || { warn "user $u missing — crontab skipped"; continue; }
    act crontab -u "$u" "$f"; info "crontab for $u"
  done
  for f in /etc/crontab /etc/anacrontab /etc/cron.d /etc/cron.hourly /etc/cron.daily /etc/cron.weekly /etc/cron.monthly; do restore_path "$f"; done
}

with_rollback() { # with_rollback "apply" "rollback"
  local apply=$1 rollback=$2 a rpid
  if ((DRY)); then printf '    [dry-run] %s   (auto-rollback: %s)\n' "$apply" "$rollback"; return 0; fi
  if [[ -n ${SSH_CONNECTION:-} ]]; then
    setsid bash -c "sleep 100; $rollback" >/dev/null 2>&1 &
    rpid=$!
    if ! bash -c "$apply"; then kill "$rpid" 2>/dev/null; warn "apply failed — rolling back"; bash -c "$rollback"; return 1; fi
    if read -r -t 90 -p "  Firewall applied. Open a NEW ssh session to check you can still log in, then type 'ok' here within 90s: " a </dev/tty && [[ $a == ok ]]; then
      kill "$rpid" 2>/dev/null; ok "firewall kept"
    else
      warn "not confirmed — firewall will be rolled back in a few seconds"
    fi
  else
    bash -c "$apply"
  fi
}

restore_firewall() {
  local m; m=$(cat "$SNAP/firewall/managers.txt" 2>/dev/null || true)
  [[ -n $m ]] || { info "no firewall manager was active on the old server"; }
  local oldif; oldif=$(awk '{print $1}' "$SNAP/network/links.txt" 2>/dev/null | grep -v '^lo$' | xargs)
  info "rules may reference old interface names: $oldif   (this machine: $(ip -br link | awk '{print $1}' | grep -vE '^(lo|veth|br-|docker0)' | xargs))"
  if grep -qx ufw <<<"$m"; then
    have ufw || apt_install ufw
    restore_path /etc/ufw; restore_path /etc/default/ufw
    with_rollback "ufw --force disable >/dev/null; ufw --force enable" "ufw --force disable"
  fi
  if grep -qx nftables <<<"$m"; then
    restore_path /etc/nftables.conf
    with_rollback "nft -f /etc/nftables.conf && systemctl enable nftables && systemctl restart docker" "nft flush ruleset; systemctl restart docker"
  fi
  if grep -qx iptables-persistent <<<"$m" || { [[ -z $m ]] && [[ -s $SNAP/firewall/iptables.rules ]] && grep -qE '^-A (INPUT|DOCKER-USER)' "$SNAP/firewall/iptables.rules"; }; then
    if ! grep -qx iptables-persistent <<<"$m"; then ask "Old server had custom iptables rules without a persistence tool. Restore them via iptables-persistent?" y || return 0; fi
    act bash -c 'echo "iptables-persistent iptables-persistent/autosave_v4 boolean false" | debconf-set-selections; echo "iptables-persistent iptables-persistent/autosave_v6 boolean false" | debconf-set-selections'
    apt_install iptables-persistent
    act mkdir -p /etc/iptables
    local v4=$BF/etc/iptables/rules.v4 v6=$BF/etc/iptables/rules.v6
    [[ -s $v4 ]] || v4=$SNAP/firewall/iptables.rules
    [[ -s $v6 ]] || v6=$SNAP/firewall/ip6tables.rules
    if ((DRY)); then info "(dry-run) would write filtered rules (docker chains removed) to /etc/iptables/rules.v4/.v6"
    else
      ipt_filter <"$v4" >/etc/iptables/rules.v4
      [[ -s $v6 ]] && ipt_filter <"$v6" >/etc/iptables/rules.v6
    fi
    with_rollback "iptables-restore < /etc/iptables/rules.v4 && { [ ! -s /etc/iptables/rules.v6 ] || ip6tables-restore < /etc/iptables/rules.v6; } && systemctl enable netfilter-persistent && systemctl restart docker" \
                  "iptables -P INPUT ACCEPT; iptables -P FORWARD ACCEPT; iptables -F INPUT; systemctl restart docker"
  fi
  if grep -qx fail2ban <<<"$m"; then have fail2ban-client || apt_install fail2ban; restore_path /etc/fail2ban; act systemctl enable --now fail2ban; act systemctl restart fail2ban; fi
  if grep -qx crowdsec <<<"$m"; then info "crowdsec: package + /etc/crowdsec restored; re-run 'cscli bouncers add' if the bouncer can't reach the LAPI"; act systemctl restart crowdsec 2>/dev/null || true; fi
  if grep -qx firewalld <<<"$m"; then warn "firewalld: /etc/firewalld restored in the bundle — copy and 'firewall-cmd --reload' manually"; fi
  info "Not captured: rules on your router, Cloudflare (WAF/Access/IP rules), VPS provider firewall."
}

restore_verify() {
  echo "  Containers that were running but aren't now:"
  local want have_now; want=$(awk -F'\t' '$2=="running"{print $1}' "$VOL/docker-ps.tsv" 2>/dev/null | sort)
  have_now=$(docker ps --format '{{.Names}}' 2>/dev/null | sort)
  comm -23 <(echo "$want") <(echo "$have_now") | grep . | sed 's/^/    ✗ /' || echo "    none ✓"
  echo "  Listening ports missing compared to old server:"
  local oldp newp
  oldp=$(awk '{print $1, $2}' "$VOL/listening.txt" 2>/dev/null | sed -E 's/%[a-z0-9]+//' | sort -u)
  newp=$(ss -tulnH | awk '{print $1, $5}' | sed -E 's/%[a-z0-9]+//' | sort -u)
  comm -23 <(echo "$oldp") <(echo "$newp") | grep -vE ':[0-9]{5}$' | grep . | sed 's/^/    ✗ /' || echo "    none ✓"
  echo "  Mounts missing:"
  local m; while read -r m _; do findmnt "$m" >/dev/null 2>&1 || echo "    ✗ $m"; done < <(awk '{print $1}' "$SNAP/storage/mounts.txt" 2>/dev/null)
  echo "  Failed units:"; systemctl list-units --failed --no-legend --plain | sed 's/^/    /' | grep . || echo "    none ✓"
  if ask "Install serverstate on this machine and continue the same change history?" y; then
    if [[ ! -d $STATE_DIR/.git && -d $BUNDLE/state ]]; then act mkdir -p "$(dirname "$STATE_DIR")"; act cp -a "$BUNDLE/state" "$STATE_DIR"; fi
    [[ -r $BUNDLE/.passphrase && ! -e $PASSPHRASE_FILE ]] && act install -m 600 "$BUNDLE/.passphrase" "$PASSPHRASE_FILE"
    act bash "$LIB_DIR/install.sh" --noninteractive
  fi
}

cmd_restore() {
  need_root restore
  umask 022
  # A half-finished migration is worse than a warning: keep going on non-fatal errors (die() still exits)
  set +e +o pipefail
  local only="" from="" skip="" a
  DRY=0 ASSUME_YES=0 BUNDLE=""
  while (($#)); do
    case $1 in
      --bundle) BUNDLE=$2; shift ;;
      --only) only=$2; shift ;;
      --from) from=$2; shift ;;
      --skip) skip=$2; shift ;;
      --dry-run|-n) DRY=1 ;;
      --yes|-y) ASSUME_YES=1 ;;
      --list) for a in "${PHASES[@]}"; do printf '  %-14s %s\n' "$a" "${PHASE_DESC[$a]}"; done; return 0 ;;
      *) die "unknown option $1" ;;
    esac; shift
  done
  [[ -n $BUNDLE ]] || die "usage: serverstate restore --bundle DIR|FILE [--dry-run] [--only p1,p2] [--from phase] [--skip p]"
  if [[ -f $BUNDLE ]]; then local d=/root/serverstate-restore/$(date +%Y%m%d-%H%M%S); extract_bundle "$BUNDLE" "$d"; BUNDLE=$d; fi
  [[ -d $BUNDLE/state/snapshot ]] || die "$BUNDLE does not look like an extracted serverstate bundle"
  BUNDLE=$(readlink -f "$BUNDLE")
  SNAP=$BUNDLE/state/snapshot VOL=$BUNDLE/state/volatile BF=$BUNDLE/state/snapshot/files
  # settings of the OLD server (backup restore command etc.), then local overrides
  # shellcheck source=/dev/null
  [[ -r $BF/etc/serverstate.conf ]] && . "$BF/etc/serverstate.conf"
  # shellcheck source=/dev/null
  [[ -r $CONF ]] && . "$CONF"
  mkdir -p /root/serverstate-restore
  exec > >(tee -a /root/serverstate-restore/restore.log) 2>&1
  log "serverstate restore $( ((DRY)) && echo '(DRY RUN — nothing will change)')  bundle: $BUNDLE"
  local started=0 ph
  [[ -z $from ]] && started=1
  for ph in "${PHASES[@]}"; do
    [[ $ph == "$from" ]] && started=1
    ((started)) || continue
    [[ -n $only && ",$only," != *",$ph,"* ]] && continue
    [[ ",$skip," == *",$ph,"* ]] && continue
    echo
    log "phase: $ph — ${PHASE_DESC[$ph]}"
    if ((!DRY)) && [[ $ph != preflight ]] && ! ask "Run phase '$ph'?" y; then info "skipped"; continue; fi
    "restore_${ph//-/_}"
  done
  echo; ok "restore finished. Log: /root/serverstate-restore/restore.log"
}

# ----------------------------------------------------------------------------
main() {
  local cmd=${1:-help}; shift || true
  case $cmd in
    snapshot) cmd_snapshot "$@" ;;
    push) cmd_push "$@" ;;
    pull) cmd_pull "$@" ;;
    restore) cmd_restore "$@" ;;
    context) cmd_context ;;
    notes) cmd_notes ;;
    log) cmd_log "$@" ;;
    diff) cmd_diff "$@" ;;
    status) cmd_status ;;
    watch) cmd_watch ;;
    hook-backup) cmd_hook_backup "$@" ;;
    audit) cmd_audit ;;
    uninstall) cmd_uninstall "$@" ;;
    final-backup) cmd_final_backup ;;
    version|--version) echo "serverstate $SS_VERSION" ;;
    help|-h|--help) sed -n '2,23p' "$SELF" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$cmd' (see: serverstate help)" ;;
  esac
}
main "$@"
